{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-cup-engineering.invalid/schemas/provider-effect-receipt.schema.json",
  "$defs": {"status": {"enum": ["pass", "fail", "not-claimed", "not-applicable"]}, "dimension": {"enum": ["artifactByteParity", "requestedProviderRoute", "effectScopeAndCustody", "dnsTlsPath", "accessPolicy", "rollback"]}},
  "type": "object",
  "required": ["type", "formationDigest", "artifactDigest", "targetDigest", "artifactAttestationDigest", "receiptDigest", "residue"],
  "properties": {
    "type": {"const": "ProviderEffectReceipt"},
    "formationDigest": {"type": "string", "pattern": "^ni:///sha-256;"},
    "artifactDigest": {"type": "string", "pattern": "^ni:///sha-256;"},
    "targetDigest": {"type": "string", "pattern": "^ni:///sha-256;"},
    "artifactAttestationDigest": {"type": "string", "pattern": "^ni:///sha-256;"},
    "receiptDigest": {"type": "string", "pattern": "^ni:///sha-256;"},
    "requiredResidues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dimension"}},
    "residue": {"type": "object", "required": ["artifactByteParity", "requestedProviderRoute", "effectScopeAndCustody", "dnsTlsPath", "accessPolicy", "rollback"], "properties": {"artifactByteParity":{"$ref":"#/$defs/status"},"requestedProviderRoute":{"$ref":"#/$defs/status"},"effectScopeAndCustody":{"$ref":"#/$defs/status"},"dnsTlsPath":{"$ref":"#/$defs/status"},"accessPolicy":{"$ref":"#/$defs/status"},"rollback":{"$ref":"#/$defs/status"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
